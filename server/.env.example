NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://127.0.0.1:5173
# Leave blank to persist development data in server/.data/store.json.
# Set to mongodb://127.0.0.1:27017/menumate or your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/restuarantwebsite
# Optional when the URI already contains the database path; set explicitly in production.
MONGODB_DB_NAME=restuarantwebsite
# Optional one-time copy source; production uses this to recover data written to MongoDB's default.
# MONGODB_MIGRATE_FROM=test
# Optional absolute path on persistent storage; defaults to server/.uploads.
# MENUMATE_UPLOAD_DIR=

# Razorpay TEST credentials only. Never prefix these with VITE_.
# Live key IDs are intentionally rejected until real restaurant operations are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
