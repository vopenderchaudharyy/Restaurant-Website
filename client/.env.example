# Development proxy target. Change this if you change the API port.
API_PROXY_TARGET=http://127.0.0.1:5000
# Only public values may use the VITE_ prefix; they are bundled into the browser.
VITE_API_BASE_URL=/api
# Set true only for a frontend-only deployment. Public demo restaurants and menus remain browsable
# when the API is unavailable; accounts, orders and partner tools still require the Express API.
VITE_STATIC_DEMO=false
