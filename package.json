{
  "name": "menumate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n API,WEB -c cyan,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client",
    "lint": "eslint .",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "npm run db:start --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "test:mongo": "npm run test:mongo --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
